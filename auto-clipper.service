[Unit]
Description=Auto-Clipper Telegram Bot Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Resilience
ExecStart=/root/Resilience/.venv/bin/python3 /root/Resilience/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
